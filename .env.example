# Conexión a MongoDB (Dockploy interno o local)
MONGODB_URI=

# Firma de los JWT
JWT_SECRET=

# Puerto del backend (usar uno distinto al 5000 de Supervisión si conviven en el mismo VPS)
PORT=5001

# URL pública del backend, usada para construir el link de las fotos de boletas subidas
PUBLIC_URL=https://gastos-locales-back.vertigs.net
